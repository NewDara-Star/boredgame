{
  "name": "boredgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-all.mjs && tsc -b && vite build",
    "check": "node scripts/check-all.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:squareoff": "node --experimental-strip-types scripts/check-squareoff.mts",
    "check:options": "node --experimental-strip-types scripts/check-options.mts",
    "check:dealer": "node --experimental-strip-types scripts/check-dealer.mts",
    "check:sort": "node --experimental-strip-types scripts/check-sort.mts",
    "check:layout": "node --experimental-strip-types scripts/check-layout.mts",
    "check:lobby": "node --experimental-strip-types scripts/check-lobby.mts",
    "check:schema": "node --experimental-strip-types scripts/check-schema.mts",
    "check:fire": "node --experimental-strip-types scripts/check-fire.mts",
    "check:answers": "node --experimental-strip-types scripts/check-answers.mts",
    "check:catapult": "node --experimental-strip-types scripts/check-catapult.mts",
    "check:clock": "node --experimental-strip-types scripts/check-clock.mts",
    "check:connect4": "node --experimental-strip-types scripts/check-connect4.mts",
    "check:engines": "node --experimental-strip-types scripts/check-engines.mts",
    "check:memory": "node --experimental-strip-types scripts/check-memory.mts",
    "check:rebus": "node --experimental-strip-types scripts/check-rebus.mts",
    "check:scope": "node --experimental-strip-types scripts/check-scope.mts",
    "check:tictactoe": "node --experimental-strip-types scripts/check-tictactoe.mts",
    "check:timeout": "node --experimental-strip-types scripts/check-timeout.mts",
    "check:type-size": "node --experimental-strip-types scripts/check-type-size.mts",
    "check:brand": "node scripts/check-brand.mjs",
    "check:brand:list": "node scripts/check-brand.mjs --list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
