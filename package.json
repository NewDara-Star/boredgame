{
  "name": "boredgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:squareoff": "node --experimental-strip-types scripts/check-squareoff.mts",
    "check:options": "node --experimental-strip-types scripts/check-options.mts",
    "check:dealer": "node --experimental-strip-types scripts/check-dealer.mts",
    "check:sort": "node --experimental-strip-types scripts/check-sort.mts",
    "check:layout": "node --experimental-strip-types scripts/check-layout.mts",
    "check:lobby": "node --experimental-strip-types scripts/check-lobby.mts",
    "check:schema": "node --experimental-strip-types scripts/check-schema.mts",
    "check:fire": "node --experimental-strip-types scripts/check-fire.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
